{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "monitor-cmpc-preview",
  "main": "./worker.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cmpc-operational-preview",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_YOUR_CLOUDFLARE_ACCESS_TEAM_DOMAIN",
    "ACCESS_AUD": "REPLACE_WITH_CLOUDFLARE_ACCESS_APPLICATION_AUD"
  }
}
